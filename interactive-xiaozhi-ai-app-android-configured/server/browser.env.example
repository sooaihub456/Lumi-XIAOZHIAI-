BROWSER_HOST=127.0.0.1
BROWSER_PORT=8790
# Generate a long random value privately. Never commit or embed the real token.
BROWSER_TOKEN=
BROWSER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8790,http://localhost:8790,https://localhost
BROWSER_MAX_SESSIONS=2
# Also serve the built Mori app on the browser-service port.
BROWSER_SERVE_APP=1
# Use the full Chromium engine, not an iframe or a page-data proxy.
BROWSER_CHANNEL=chromium
BROWSER_HEADLESS=true